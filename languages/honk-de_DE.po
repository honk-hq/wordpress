msgid "Notify me after %1$s or more failed sign-ins within %2$s minutes."
msgstr "Mitteilung ab %1$s fehlgeschlagenen Anmeldeversuchen innerhalb von %2$s Minuten."

#: includes/class-honk-admin.php:396
msgid "Failed sign-ins"
msgstr "Fehlgeschlagene Anmeldeversuche"

#: includes/class-honk-admin.php:397
msgid "Minutes"
msgstr "Minuten"

