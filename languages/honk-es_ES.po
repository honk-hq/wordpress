msgstr "Honk ha devuelto un error (%1$d %2$s): %3$s"

#: includes/class-honk-admin.php:665
msgid "Order, payment, stock, customer and review notifications are set up under Settings → Honk, with the rest of the site’s notifications."
msgstr "Las notificaciones de pedidos, pagos, inventario, clientes y valoraciones se configuran en Ajustes → Honk, junto con el resto de notificaciones del sitio."

#: includes/class-honk-events.php:151
msgid "Security"
msgstr "Seguridad"

#: includes/class-honk-events.php:152
