#. Plugin Name of the plugin
#: honk.php
msgid "Honk – Notifications for Sites, Shops and Forms"
msgstr "Honk – Notificaciones de webs, tiendas y formularios"

#. Plugin URI of the plugin
#: honk.php
msgid "https://honk-me.app"
msgstr "https://honk-me.app/es"

#. Description of the plugin
#: honk.php
msgid "Orders, failed payments, form entries, suspicious sign-ins and site errors from WordPress and WooCommerce, in your Honk inbox on iPhone, Apple Watch and the web."
msgstr "Pedidos, pagos fallidos, formularios recibidos, accesos sospechosos y errores del sitio, desde WordPress y WooCommerce hasta tu bandeja de entrada de Honk en el iPhone, el Apple Watch y la web."

#. Author of the plugin
#: honk.php
#: includes/class-honk-admin.php:57
