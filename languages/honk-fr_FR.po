#. Plugin Name of the plugin
#: honk.php
msgid "Honk – Notifications for Sites, Shops and Forms"
msgstr "Honk – Notifications pour sites, boutiques et formulaires"

#. Plugin URI of the plugin
#: honk.php
msgid "https://honk-me.app"
msgstr "https://honk-me.app/fr"

#. Description of the plugin
#: honk.php
msgid "Orders, failed payments, form entries, suspicious sign-ins and site errors from WordPress and WooCommerce, in your Honk inbox on iPhone, Apple Watch and the web."
msgstr "Commandes, paiements échoués, formulaires reçus, connexions suspectes et erreurs de votre site WordPress ou WooCommerce, dans votre boîte de réception Honk sur iPhone, Apple Watch et le web."

