msgstr "Nu m-am putut conecta la %1$s: %2$s"

#: includes/class-honk-admin.php:637
msgid "Honk didn’t accept this key. Check that you copied all of it and that it hasn’t been revoked in Honk."
msgstr "Honk nu a acceptat cheia. Verifică dacă ai copiat-o în întregime și dacă nu a fost revocată în Honk."

#. translators: 1: HTTP status, 2: error code, 3: error message
#: includes/class-honk-admin.php:640
#, php-format
