    "site_identity_changed": {
        "off": [
            {
                "event": "site_identity_changed",
                "pii": false,
                "payload": {
                    "title": "Administration email address changed",
                    "message": "Changed by an administrator.\nIf you didn’t expect this, check Settings → General now.",
                    "severity": "error",
                    "priority": "high",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/site-identity",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/options-general.php",
                    "metadata": {
                        "option": "admin_email"
                    }
                }
            },
            {
                "event": "site_identity_changed",
                "pii": false,
                "payload": {
                    "title": "Site address (URL) changed",
                    "message": "https://old.example.com → https://shop.example.com, by an administrator.\nIf you didn’t expect this, check Settings → General now.",
                    "severity": "error",
                    "priority": "high",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/site-identity",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/options-general.php",
                    "metadata": {
                        "option": "home"
                    }
                }
            }
        ]
    },
    "plugin_changed": {
        "off": [
            {
                "event": "plugin_changed",
                "pii": false,
                "payload": {
                    "title": "Plugin activated: acme",
                    "message": "acme/acme.php",
                    "severity": "warning",
                    "priority": "normal",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/plugins",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/plugins.php",
                    "metadata": {
                        "plugin": "acme/acme.php",
                        "action": "activated"
                    }
                }
            },
            {
                "event": "plugin_changed",
                "pii": false,
                "payload": {
                    "title": "Plugin deactivated: hello-dolly",
                    "message": "Network-wide.\nhello-dolly/hello.php",
                    "severity": "warning",
                    "priority": "normal",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/plugins",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/plugins.php",
                    "metadata": {
                        "plugin": "hello-dolly/hello.php",
                        "action": "deactivated"
                    }
                }
            }
        ],
        "on": [
            {
                "event": "plugin_changed",
                "pii": true,
                "payload": {
                    "title": "Plugin activated: acme",
                    "message": "By admin.\nacme/acme.php",
                    "severity": "warning",
                    "priority": "normal",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/plugins",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/plugins.php",
                    "metadata": {
                        "plugin": "acme/acme.php",
                        "action": "activated"
                    }
                }
            },
            {
                "event": "plugin_changed",
                "pii": true,
                "payload": {
                    "title": "Plugin deactivated: hello-dolly",
                    "message": "By admin. Network-wide.\nhello-dolly/hello.php",
                    "severity": "warning",
                    "priority": "normal",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/plugins",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/plugins.php",
                    "metadata": {
                        "plugin": "hello-dolly/hello.php",
                        "action": "deactivated"
                    }
                }
            }
        ]
    },
