{
    "admin_login_new_device": {
        "off": [
            {
                "event": "admin_login_new_device",
                "pii": false,
                "payload": {
                    "title": "An administrator signed in from a new device",
                    "message": "Device: Firefox on Linux\nNetwork: 203.0.113.0/24\nThis account hasn’t used this browser and device before.\nIf this wasn’t you, change the password and click “Log Out Everywhere Else” in Users → Profile.",
                    "severity": "warning",
                    "priority": "normal",
                    "source": "shop.example.com",
                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/admin-login",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/profile.php",
                    "metadata": {
                        "user_id": 1
                    }
                }
            }
        ]
    },
    "new_administrator": {
