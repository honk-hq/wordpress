                    "environment": "production",
                    "channel": "security",
                    "group_key": "wp/security/admins",
                    "category": "security",
                    "url": "https://shop.example.com/wp-admin/user-edit.php?user_id=51",
                    "metadata": {
                        "user_id": 51
                    }
                }
            },
            {
                "event": "new_administrator",
                "pii": false,
